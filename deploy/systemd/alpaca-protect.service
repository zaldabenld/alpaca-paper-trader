[Unit]
Description=Alpaca Paper Trader headless stop protection
Documentation=file://@ROOT@/OPERATING.md

[Service]
Type=oneshot
Environment=ALPACA_TRADER_DISABLE_DAY_TAPE=1
# Optional: N8N_HEARTBEAT_URL and N8N_CONTROL_TOKEN for the n8n watchdog / kill switch.
EnvironmentFile=-%h/.config/alpaca-paper-trader/n8n.env
ExecStart=@ROOT@/.venv/bin/python @ROOT@/python_app/protect.py
Nice=10
TimeoutStartSec=300
